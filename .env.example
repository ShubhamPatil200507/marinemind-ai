# MarineMind AI — Production Environment Variables
# Copy to .env for local development or configure in your Render Dashboard.
# NEVER commit .env to version control.

# ==============================================================================
# REQUIRED (Application startup will fail if JWT_SECRET is missing or < 32 chars)
# ==============================================================================
# Generate a 32+ character secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ==============================================================================
# ENVIRONMENT & NETWORKING
# ==============================================================================
# Set to 'production' on Render / deployment, or 'development' locally
APP_ENV=development

# Server port and host (Render injects $PORT automatically)
PORT=8000
HOST=0.0.0.0

# Production CORS allowlist: Set to your actual frontend origin (e.g. https://marinemind-ai.onrender.com)
# For single-service deployments where FastAPI serves the frontend SPA directly, leave blank.
FRONTEND_URL=

# Vite Frontend API base URL (Used during frontend build if backend is a separate service)
# If using unified service, leave blank (defaults to /api)
VITE_API_URL=

# ==============================================================================
# DATABASE
# ==============================================================================
# Default SQLite database path (kept in local container/disk)
DATABASE_URL=sqlite:///./marinemind.db

# ==============================================================================
# OPTIONAL AI / EXTERNAL TELEMETRY
# ==============================================================================
# Optional Google Gemini key from https://aistudio.google.com/
# Leave blank to use the built-in offline LocalMarineReasoner engine
GEMINI_API_KEY=

# Open-Meteo external request timeout in seconds (default: 5.0)
OPEN_METEO_TIMEOUT=5.0

# Optional India Meteorological Department (IMD) API key (https://api.imd.gov.in)
# If left blank, MarineMind AI automatically falls back to live IMD Coastal Bulletins without a key
IMD_API_KEY=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

